        "title": "M80: Next look"
      },
      {
        "command": "m80.alternarSuave",
        "title": "M80: Toggle original / soft"
      },
      {
        "command": "m80.instalar",
        "title": "M80: Install or update components"
      },
      {
        "command": "m80.desinstalar",
        "title": "M80: Uninstall components"
      },
      {
        "command": "m80.visual.clipper",
