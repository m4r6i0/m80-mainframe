    "configuration": {
      "title": "M80 Retro",
      "properties": {
        "m80.visual": {
          "type": "string",
          "default": "clipper",
          "description": "Last M80 look applied (written by the extension)."
        },
        "m80.rotacao": {
          "type": "string",
          "enum": [
            "automatica",
            "botao"
          ],
          "default": "automatica",
          "enumDescriptions": [
            "After 85% of the context, at the next pause, opens a new conversation with the handoff card and closes the oldest one",
            "Only rotates when you click the button in the M80 Console"
          ],
          "description": "How the rotation of Claude conversations happens."
        },
        "m80.maxConversas": {
          "type": "number",
          "default": 3,
          "minimum": 2,
          "maximum": 8,
          "description": "How many Claude conversations stay open in tabs (the oldest is closed on rotation)."
        },
        "m80.efeitos.mapa": {
          "type": "string",
          "enum": [
            "nenhum",
            "lixeira",
            "rio",
            "enxame",
            "keystone",
            "kaboom",
            "missil",
            "selva",
            "invasores",
            "sapo",
            "asteroides",
            "pong",
            "enduro",
            "comilao",
            "poco",
            "explosao",
            "fogos"
          ],
          "enumDescriptions": [
            "None",
            "Desk Trash",
            "River Raid",
            "Megamania",
            "Keystone Kapers",
            "Kaboom!",
            "Missile Command",
            "Pitfall!",
            "Space Invaders",
            "Frogger",
            "Asteroids",
            "Pong",
            "Enduro",
            "Pac-Man",
            "Block Well",
            "Blast",
            "Fireworks Sky"
          ],
          "default": "lixeira",
          "description": "Arcade window effect in the M80 Console Map when a tool finishes."
        },
        "m80.monitor.layout": {
          "type": "string",
          "enum": [
            "sinotico",
            "teletexto",
            "circuito",
            "radar"
          ],
          "enumDescriptions": [
            "Signal box panel: each action is a stretch of track with lamps and a signal",
            "Teletext page: 8 colors, mosaic graphics and double height",
            "Circuit board: chips, 45° traces and 7-segment displays",
            "Approach radar: the session is a flight, subagents take off, tools become fixes; flight strips on the side"
          ],
          "default": "sinotico",
          "description": "Layout of the M80 Console Map tab."
        },
        "m80.monitor.forma": {
          "type": "string",
          "enum": [
            "auto",
            "manifest",
            "fosforo",
            "lotus",
            "norton",
            "moderna"
          ],
          "enumDescriptions": [
            "Automatic: picks from the theme colors (M80 looks have their own shape)",
            "CGA boxes, double border, hard shadow",
            "Glowing outlines and scan lines, monochrome",
            "1-2-3 Spreadsheet: regions as named ranges",
            "Commander: panels with the title in the frame",
            "Modern: clean cards and the theme accent (used by the Modern themes)"
          ],
          "default": "auto",
          "description": "Shape of the M80 Console interface. Colors always come from the active theme."
        },
        "m80.efeitos.animar": {
          "type": "string",
          "enum": [
            "sistema",
            "sempre",
            "nunca"
          ],
          "default": "sistema",
          "enumDescriptions": [
            "Follows the Windows \"reduce motion\" setting",
            "Always animate",
            "Never animate"
          ],
          "description": "When the M80 Console effects animate."
        },
        "m80.monitor.arcade": {
          "type": "string",
          "enum": [
            "shown",
            "hidden"
          ],
          "enumDescriptions": [
            "Show the Arcade game window in the Map",
            "Hide it: the Map takes its space"
          ],
          "default": "shown",
          "description": "Arcade window in the M80 Console Map."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "m80",
          "title": "M80 Manifest",
          "icon": "media/m80.svg"
        }
      ],
      "panel": [
        {
          "id": "m80monitor",
          "title": "M80 Console",
          "icon": "media/m80.svg"
