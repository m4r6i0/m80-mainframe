{
  "$schema": "vscode://schemas/color-theme",
  "name": "M80 Ember Soft",
  "type": "dark",
  "semanticHighlighting": false,
  "colors": {
    "foreground": "#CEC8C3",
    "focusBorder": "#E47F45",
    "contrastBorder": "#2C2A2A",
    "widget.shadow": "#00000000",
    "selection.background": "#392C27",
    "editor.background": "#1F1E1F",
    "editor.foreground": "#CEC8C3",
    "editorCursor.foreground": "#E47F45",
    "editor.selectionBackground": "#392C27",
    "editor.inactiveSelectionBackground": "#392C2780",
    "editor.selectionHighlightBackground": "#392C2755",
    "editor.wordHighlightBackground": "#392C2740",
    "editor.findMatchBackground": "#E47F45",
    "editor.findMatchHighlightBackground": "#392C2766",
    "editor.lineHighlightBackground": "#1F1E1F",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#988D85",
    "editorLineNumber.activeForeground": "#CEC8C3",
    "editorIndentGuide.background1": "#00000000",
    "editorWhitespace.foreground": "#988D8580",
    "editorGutter.background": "#1F1E1F",
    "editorWidget.background": "#1C1B1D",
    "editorWidget.foreground": "#CEC8C3",
    "editorWidget.border": "#2C2A2A",
    "editorSuggestWidget.background": "#1C1B1D",
    "editorSuggestWidget.foreground": "#CEC8C3",
    "editorSuggestWidget.selectedBackground": "#392C27",
    "editorSuggestWidget.selectedForeground": "#CEC8C3",
    "editorHoverWidget.background": "#1C1B1D",
    "editorHoverWidget.foreground": "#CEC8C3",
    "editorHoverWidget.border": "#2C2A2A",
    "editorHoverWidget.statusBarBackground": "#1C1B1D",
    "widget.border": "#2C2A2A",
    "editorSuggestWidget.border": "#2C2A2A",
    "editorGroup.border": "#2C2A2A",
    "editorGroupHeader.tabsBackground": "#1C1B1D",
    "editorGroupHeader.noTabsBackground": "#1C1B1D",
    "breadcrumb.background": "#1C1B1D",
    "breadcrumb.foreground": "#988D85",
    "tab.activeBackground": "#1F1E1F",
    "tab.activeForeground": "#CEC8C3",
    "tab.inactiveBackground": "#1C1B1D",
    "tab.inactiveForeground": "#988D85",
    "tab.border": "#1C1B1D",
    "tab.activeBorder": "#E47F45",
    "titleBar.activeBackground": "#18181A",
    "titleBar.activeForeground": "#CEC8C3",
    "titleBar.inactiveBackground": "#18181A",
    "titleBar.inactiveForeground": "#CEC8C3",
    "titleBar.border": "#2C2A2A",
    "menubar.selectionBackground": "#E47F45",
    "menubar.selectionForeground": "#000000",
    "menu.background": "#18181A",
    "menu.foreground": "#CEC8C3",
    "menu.selectionBackground": "#E47F45",
    "menu.selectionForeground": "#000000",
    "menu.border": "#2C2A2A",
    "activityBar.background": "#18181A",
    "activityBar.foreground": "#988D85",
    "activityBar.inactiveForeground": "#988D8599",
    "activityBarBadge.background": "#E47F45",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#1C1B1D",
    "sideBar.foreground": "#CEC8C3",
    "sideBar.border": "#2C2A2A",
    "sideBarTitle.foreground": "#CEC8C3",
    "sideBarSectionHeader.background": "#1C1B1D",
    "sideBarSectionHeader.foreground": "#988D85",
    "list.activeSelectionBackground": "#392C27",
    "list.activeSelectionForeground": "#CEC8C3",
    "list.inactiveSelectionBackground": "#2A2322",
    "list.inactiveSelectionForeground": "#CEC8C3",
    "list.focusBackground": "#392C27",
    "list.focusForeground": "#CEC8C3",
    "list.focusOutline": "#E47F45",
    "list.hoverBackground": "#2C2523",
    "list.highlightForeground": "#E47F45",
    "statusBar.background": "#E47F45",
    "statusBar.foreground": "#000000",
    "statusBar.noFolderBackground": "#E47F45",
    "statusBar.noFolderForeground": "#000000",
    "statusBar.debuggingBackground": "#AA0000",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.border": "#E47F45",
    "statusBarItem.hoverBackground": "#392C27",
    "statusBarItem.remoteBackground": "#E47F45",
    "statusBarItem.remoteForeground": "#000000",
    "panel.background": "#1F1E1F",
    "panel.border": "#2C2A2A",
    "panelTitle.activeForeground": "#CEC8C3",
    "panelTitle.activeBorder": "#E47F45",
    "panelTitle.inactiveForeground": "#988D85",
    "terminal.background": "#19181A",
    "terminal.foreground": "#CEC8C3",
    "terminalCursor.foreground": "#E47F45",
    "terminal.selectionBackground": "#392C2799",
    "input.background": "#1C1B1D",
    "input.foreground": "#CEC8C3",
    "input.border": "#2C2A2A",
    "dropdown.background": "#1C1B1D",
    "dropdown.foreground": "#CEC8C3",
    "dropdown.border": "#2C2A2A",
    "quickInput.background": "#1C1B1D",
    "quickInput.foreground": "#CEC8C3",
    "quickInputList.focusBackground": "#392C27",
    "quickInputList.focusForeground": "#CEC8C3",
    "button.background": "#E47F45",
    "button.foreground": "#000000",
    "button.hoverBackground": "#392C27",
    "badge.background": "#E47F45",
    "badge.foreground": "#000000",
    "scrollbarSlider.background": "#392C2780",
    "scrollbarSlider.hoverBackground": "#392C27AA",
    "scrollbarSlider.activeBackground": "#392C27",
    "textPreformat.foreground": "#A5C47D",
    "textPreformat.background": "#FFFFFF1A",
    "textCodeBlock.background": "#00000040",
    "textBlockQuote.background": "#FFFFFF0F",
    "textLink.foreground": "#E4925F",
    "textLink.activeForeground": "#E47F45",
    "notifications.background": "#1C1B1D",
    "notifications.foreground": "#CEC8C3",
    "notifications.border": "#2C2A2A",
    "peekView.border": "#2C2A2A",
    "gitDecoration.modifiedResourceForeground": "#FFFF55",
    "gitDecoration.untrackedResourceForeground": "#55FF55",
    "gitDecoration.deletedResourceForeground": "#FF5555",
    "errorForeground": "#FF5555",
    "editorError.foreground": "#FF5555",
    "editorWarning.foreground": "#FFFF55",
    "editorInfo.foreground": "#55FFFF",
    "minimap.background": "#1F1E1F",
    "terminal.ansiBlack": "#3B3F46",
    "terminal.ansiRed": "#FF6B6B",
    "terminal.ansiGreen": "#7BD88F",
    "terminal.ansiYellow": "#F3C677",
    "terminal.ansiBlue": "#6AA6FF",
    "terminal.ansiMagenta": "#C792EA",
    "terminal.ansiCyan": "#5FD0D6",
    "terminal.ansiWhite": "#D9DDE3",
    "terminal.ansiBrightBlack": "#6B7280",
    "terminal.ansiBrightRed": "#FF8F8F",
    "terminal.ansiBrightGreen": "#9BE7AC",
    "terminal.ansiBrightYellow": "#FFD88F",
    "terminal.ansiBrightBlue": "#8FBAFF",
    "terminal.ansiBrightMagenta": "#DCB0FF",
    "terminal.ansiBrightCyan": "#86E3E8",
    "terminal.ansiBrightWhite": "#FFFFFF"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#988D85",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E4925F",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#A5C47D"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#DCBB5F"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#7EB3D0"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#C998E4"
      }
    },
    {
      "scope": [
        "variable",
        "meta",
        "punctuation",
        "source"
      ],
      "settings": {
        "foreground": "#CEC8C3"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#E4925F",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7EB3D0"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#55FF55"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#FF5555"
      }
    }
  ]
}
