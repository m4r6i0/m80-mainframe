{
  "$schema": "vscode://schemas/color-theme",
  "name": "M80 Contrast Soft",
  "type": "dark",
  "semanticHighlighting": false,
  "colors": {
    "foreground": "#E2E2E3",
    "focusBorder": "#E2BE0B",
    "contrastBorder": "#606061",
    "widget.shadow": "#00000000",
    "selection.background": "#1F3165",
    "editor.background": "#0B0D0F",
    "editor.foreground": "#E2E2E3",
    "editorCursor.foreground": "#E2BE0B",
    "editor.selectionBackground": "#1F3165",
    "editor.inactiveSelectionBackground": "#1F316580",
    "editor.selectionHighlightBackground": "#1F316555",
    "editor.wordHighlightBackground": "#1F316540",
    "editor.findMatchBackground": "#E2BE0B",
    "editor.findMatchHighlightBackground": "#1F316566",
    "editor.lineHighlightBackground": "#0B0D0F",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#B2B2B2",
    "editorLineNumber.activeForeground": "#E2E2E3",
    "editorIndentGuide.background1": "#00000000",
    "editorWhitespace.foreground": "#B2B2B280",
    "editorGutter.background": "#0B0D0F",
    "editorWidget.background": "#121315",
    "editorWidget.foreground": "#E2E2E3",
    "editorWidget.border": "#606061",
    "editorSuggestWidget.background": "#121315",
    "editorSuggestWidget.foreground": "#E2E2E3",
    "editorSuggestWidget.selectedBackground": "#1F3165",
    "editorSuggestWidget.selectedForeground": "#E2E2E3",
    "editorHoverWidget.background": "#121315",
    "editorHoverWidget.foreground": "#E2E2E3",
    "editorHoverWidget.border": "#606061",
    "editorHoverWidget.statusBarBackground": "#121315",
    "widget.border": "#606061",
    "editorSuggestWidget.border": "#606061",
    "editorGroup.border": "#606061",
    "editorGroupHeader.tabsBackground": "#121315",
    "editorGroupHeader.noTabsBackground": "#121315",
    "breadcrumb.background": "#121315",
    "breadcrumb.foreground": "#B2B2B2",
    "tab.activeBackground": "#0B0D0F",
    "tab.activeForeground": "#E2E2E3",
    "tab.inactiveBackground": "#121315",
    "tab.inactiveForeground": "#B2B2B2",
    "tab.border": "#121315",
    "tab.activeBorder": "#E2BE0B",
    "titleBar.activeBackground": "#0B0D0F",
    "titleBar.activeForeground": "#E2E2E3",
    "titleBar.inactiveBackground": "#0B0D0F",
    "titleBar.inactiveForeground": "#E2E2E3",
    "titleBar.border": "#606061",
    "menubar.selectionBackground": "#E2BE0B",
    "menubar.selectionForeground": "#000000",
    "menu.background": "#0B0D0F",
    "menu.foreground": "#E2E2E3",
    "menu.selectionBackground": "#E2BE0B",
    "menu.selectionForeground": "#000000",
    "menu.border": "#606061",
    "activityBar.background": "#0B0D0F",
    "activityBar.foreground": "#B2B2B2",
    "activityBar.inactiveForeground": "#B2B2B299",
    "activityBarBadge.background": "#E2BE0B",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#121315",
    "sideBar.foreground": "#E2E2E3",
    "sideBar.border": "#606061",
    "sideBarTitle.foreground": "#E2E2E3",
    "sideBarSectionHeader.background": "#121315",
    "sideBarSectionHeader.foreground": "#B2B2B2",
    "list.activeSelectionBackground": "#1F3165",
    "list.activeSelectionForeground": "#E2E2E3",
    "list.inactiveSelectionBackground": "#18223D",
    "list.inactiveSelectionForeground": "#E2E2E3",
    "list.focusBackground": "#1F3165",
    "list.focusForeground": "#E2E2E3",
    "list.focusOutline": "#E2BE0B",
    "list.hoverBackground": "#151F3A",
    "list.highlightForeground": "#E2BE0B",
    "statusBar.background": "#E2BE0B",
    "statusBar.foreground": "#000000",
    "statusBar.noFolderBackground": "#E2BE0B",
    "statusBar.noFolderForeground": "#000000",
    "statusBar.debuggingBackground": "#AA0000",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.border": "#E2BE0B",
    "statusBarItem.hoverBackground": "#1F3165",
    "statusBarItem.remoteBackground": "#E2BE0B",
    "statusBarItem.remoteForeground": "#000000",
    "panel.background": "#0B0D0F",
    "panel.border": "#606061",
    "panelTitle.activeForeground": "#E2E2E3",
    "panelTitle.activeBorder": "#E2BE0B",
    "panelTitle.inactiveForeground": "#B2B2B2",
    "terminal.background": "#0B0D0F",
    "terminal.foreground": "#E2E2E3",
    "terminalCursor.foreground": "#E2BE0B",
    "terminal.selectionBackground": "#1F316599",
    "input.background": "#121315",
    "input.foreground": "#E2E2E3",
    "input.border": "#606061",
    "dropdown.background": "#121315",
    "dropdown.foreground": "#E2E2E3",
    "dropdown.border": "#606061",
    "quickInput.background": "#121315",
    "quickInput.foreground": "#E2E2E3",
    "quickInputList.focusBackground": "#1F3165",
    "quickInputList.focusForeground": "#E2E2E3",
    "button.background": "#E2BE0B",
    "button.foreground": "#000000",
    "button.hoverBackground": "#1F3165",
    "badge.background": "#E2BE0B",
    "badge.foreground": "#000000",
    "scrollbarSlider.background": "#1F316580",
    "scrollbarSlider.hoverBackground": "#1F3165AA",
    "scrollbarSlider.activeBackground": "#1F3165",
    "textPreformat.foreground": "#70E28A",
    "textPreformat.background": "#FFFFFF1A",
    "textCodeBlock.background": "#00000040",
    "textBlockQuote.background": "#FFFFFF0F",
    "textLink.foreground": "#61ABE3",
    "textLink.activeForeground": "#E2BE0B",
    "notifications.background": "#121315",
    "notifications.foreground": "#E2E2E3",
    "notifications.border": "#606061",
    "peekView.border": "#606061",
    "gitDecoration.modifiedResourceForeground": "#FFFF55",
    "gitDecoration.untrackedResourceForeground": "#55FF55",
    "gitDecoration.deletedResourceForeground": "#FF5555",
    "errorForeground": "#FF5555",
    "editorError.foreground": "#FF5555",
    "editorWarning.foreground": "#FFFF55",
    "editorInfo.foreground": "#55FFFF",
    "minimap.background": "#0B0D0F",
    "terminal.ansiBlack": "#3B3F46",
    "terminal.ansiRed": "#FF6B6B",
    "terminal.ansiGreen": "#7BD88F",
    "terminal.ansiYellow": "#F3C677",
    "terminal.ansiBlue": "#6AA6FF",
    "terminal.ansiMagenta": "#C792EA",
    "terminal.ansiCyan": "#5FD0D6",
    "terminal.ansiWhite": "#D9DDE3",
    "terminal.ansiBrightBlack": "#6B7280",
    "terminal.ansiBrightRed": "#FF8F8F",
    "terminal.ansiBrightGreen": "#9BE7AC",
    "terminal.ansiBrightYellow": "#FFD88F",
    "terminal.ansiBrightBlue": "#8FBAFF",
    "terminal.ansiBrightMagenta": "#DCB0FF",
    "terminal.ansiBrightCyan": "#86E3E8",
    "terminal.ansiBrightWhite": "#FFFFFF"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#B2B2B2",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#61ABE3",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#70E28A"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#E2BE0B"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#E28DCF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#70E2CD"
      }
    },
    {
      "scope": [
        "variable",
        "meta",
        "punctuation",
        "source"
      ],
      "settings": {
        "foreground": "#E2E2E3"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#61ABE3",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#E28DCF"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#55FF55"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#FF5555"
      }
    }
  ]
}
