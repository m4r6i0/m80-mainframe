{
  "$schema": "vscode://schemas/color-theme",
  "name": "M80 Forest Soft",
  "type": "dark",
  "semanticHighlighting": false,
  "colors": {
    "foreground": "#BFCCC4",
    "focusBorder": "#65C68C",
    "contrastBorder": "#222E2B",
    "widget.shadow": "#00000000",
    "selection.background": "#21342C",
    "editor.background": "#182020",
    "editor.foreground": "#BFCCC4",
    "editorCursor.foreground": "#65C68C",
    "editor.selectionBackground": "#21342C",
    "editor.inactiveSelectionBackground": "#21342C80",
    "editor.selectionHighlightBackground": "#21342C55",
    "editor.wordHighlightBackground": "#21342C40",
    "editor.findMatchBackground": "#65C68C",
    "editor.findMatchHighlightBackground": "#21342C66",
    "editor.lineHighlightBackground": "#182020",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#81968B",
    "editorLineNumber.activeForeground": "#BFCCC4",
    "editorIndentGuide.background1": "#00000000",
    "editorWhitespace.foreground": "#81968B80",
    "editorGutter.background": "#182020",
    "editorWidget.background": "#161D1D",
    "editorWidget.foreground": "#BFCCC4",
    "editorWidget.border": "#222E2B",
    "editorSuggestWidget.background": "#161D1D",
    "editorSuggestWidget.foreground": "#BFCCC4",
    "editorSuggestWidget.selectedBackground": "#21342C",
    "editorSuggestWidget.selectedForeground": "#BFCCC4",
    "editorHoverWidget.background": "#161D1D",
    "editorHoverWidget.foreground": "#BFCCC4",
    "editorHoverWidget.border": "#222E2B",
    "editorHoverWidget.statusBarBackground": "#161D1D",
    "widget.border": "#222E2B",
    "editorSuggestWidget.border": "#222E2B",
    "editorGroup.border": "#222E2B",
    "editorGroupHeader.tabsBackground": "#161D1D",
    "editorGroupHeader.noTabsBackground": "#161D1D",
    "breadcrumb.background": "#161D1D",
    "breadcrumb.foreground": "#81968B",
    "tab.activeBackground": "#182020",
    "tab.activeForeground": "#BFCCC4",
    "tab.inactiveBackground": "#161D1D",
    "tab.inactiveForeground": "#81968B",
    "tab.border": "#161D1D",
    "tab.activeBorder": "#65C68C",
    "titleBar.activeBackground": "#131A1A",
    "titleBar.activeForeground": "#BFCCC4",
    "titleBar.inactiveBackground": "#131A1A",
    "titleBar.inactiveForeground": "#BFCCC4",
    "titleBar.border": "#222E2B",
    "menubar.selectionBackground": "#65C68C",
    "menubar.selectionForeground": "#000000",
    "menu.background": "#131A1A",
    "menu.foreground": "#BFCCC4",
    "menu.selectionBackground": "#65C68C",
    "menu.selectionForeground": "#000000",
    "menu.border": "#222E2B",
    "activityBar.background": "#131A1A",
    "activityBar.foreground": "#81968B",
    "activityBar.inactiveForeground": "#81968B99",
    "activityBarBadge.background": "#65C68C",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#161D1D",
    "sideBar.foreground": "#BFCCC4",
    "sideBar.border": "#222E2B",
    "sideBarTitle.foreground": "#BFCCC4",
    "sideBarSectionHeader.background": "#161D1D",
    "sideBarSectionHeader.foreground": "#81968B",
    "list.activeSelectionBackground": "#21342C",
    "list.activeSelectionForeground": "#BFCCC4",
    "list.inactiveSelectionBackground": "#1C2825",
    "list.inactiveSelectionForeground": "#BFCCC4",
    "list.focusBackground": "#21342C",
    "list.focusForeground": "#BFCCC4",
    "list.focusOutline": "#65C68C",
    "list.hoverBackground": "#1D2A26",
    "list.highlightForeground": "#65C68C",
    "statusBar.background": "#65C68C",
    "statusBar.foreground": "#000000",
    "statusBar.noFolderBackground": "#65C68C",
    "statusBar.noFolderForeground": "#000000",
    "statusBar.debuggingBackground": "#AA0000",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.border": "#65C68C",
    "statusBarItem.hoverBackground": "#21342C",
    "statusBarItem.remoteBackground": "#65C68C",
    "statusBarItem.remoteForeground": "#000000",
    "panel.background": "#182020",
    "panel.border": "#222E2B",
    "panelTitle.activeForeground": "#BFCCC4",
    "panelTitle.activeBorder": "#65C68C",
    "panelTitle.inactiveForeground": "#81968B",
    "terminal.background": "#151B1B",
    "terminal.foreground": "#BFCCC4",
    "terminalCursor.foreground": "#65C68C",
    "terminal.selectionBackground": "#21342C99",
    "input.background": "#161D1D",
    "input.foreground": "#BFCCC4",
    "input.border": "#222E2B",
    "dropdown.background": "#161D1D",
    "dropdown.foreground": "#BFCCC4",
    "dropdown.border": "#222E2B",
    "quickInput.background": "#161D1D",
    "quickInput.foreground": "#BFCCC4",
    "quickInputList.focusBackground": "#21342C",
    "quickInputList.focusForeground": "#BFCCC4",
    "button.background": "#65C68C",
    "button.foreground": "#000000",
    "button.hoverBackground": "#21342C",
    "badge.background": "#65C68C",
    "badge.foreground": "#000000",
    "scrollbarSlider.background": "#21342C80",
    "scrollbarSlider.hoverBackground": "#21342CAA",
    "scrollbarSlider.activeBackground": "#21342C",
    "textPreformat.foreground": "#CEBF7E",
    "textPreformat.background": "#FFFFFF1A",
    "textCodeBlock.background": "#00000040",
    "textBlockQuote.background": "#FFFFFF0F",
    "textLink.foreground": "#71BE98",
    "textLink.activeForeground": "#65C68C",
    "notifications.background": "#161D1D",
    "notifications.foreground": "#BFCCC4",
    "notifications.border": "#222E2B",
    "peekView.border": "#222E2B",
    "gitDecoration.modifiedResourceForeground": "#FFFF55",
    "gitDecoration.untrackedResourceForeground": "#55FF55",
    "gitDecoration.deletedResourceForeground": "#FF5555",
    "errorForeground": "#FF5555",
    "editorError.foreground": "#FF5555",
    "editorWarning.foreground": "#FFFF55",
    "editorInfo.foreground": "#55FFFF",
    "minimap.background": "#182020",
    "terminal.ansiBlack": "#3B3F46",
    "terminal.ansiRed": "#FF6B6B",
    "terminal.ansiGreen": "#7BD88F",
    "terminal.ansiYellow": "#F3C677",
    "terminal.ansiBlue": "#6AA6FF",
    "terminal.ansiMagenta": "#C792EA",
    "terminal.ansiCyan": "#5FD0D6",
    "terminal.ansiWhite": "#D9DDE3",
    "terminal.ansiBrightBlack": "#6B7280",
    "terminal.ansiBrightRed": "#FF8F8F",
    "terminal.ansiBrightGreen": "#9BE7AC",
    "terminal.ansiBrightYellow": "#FFD88F",
    "terminal.ansiBrightBlue": "#8FBAFF",
    "terminal.ansiBrightMagenta": "#DCB0FF",
    "terminal.ansiBrightCyan": "#86E3E8",
    "terminal.ansiBrightWhite": "#FFFFFF"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#81968B",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#71BE98",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#CEBF7E"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#D6996F"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#8BBCE4"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#B2A4E4"
      }
    },
    {
      "scope": [
        "variable",
        "meta",
        "punctuation",
        "source"
      ],
      "settings": {
        "foreground": "#BFCCC4"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#71BE98",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8BBCE4"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#55FF55"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#FF5555"
      }
    }
  ]
}
