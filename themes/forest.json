{
  "$schema": "vscode://schemas/color-theme",
  "name": "M80 Forest",
  "type": "dark",
  "semanticHighlighting": false,
  "colors": {
    "foreground": "#d6e3da",
    "focusBorder": "#6fdc9b",
    "contrastBorder": "#25362d",
    "widget.shadow": "#00000000",
    "selection.background": "#23402f",
    "editor.background": "#15201b",
    "editor.foreground": "#d6e3da",
    "editorCursor.foreground": "#6fdc9b",
    "editor.selectionBackground": "#23402f",
    "editor.inactiveSelectionBackground": "#23402f80",
    "editor.selectionHighlightBackground": "#23402f55",
    "editor.wordHighlightBackground": "#23402f40",
    "editor.findMatchBackground": "#6fdc9b",
    "editor.findMatchHighlightBackground": "#23402f66",
    "editor.lineHighlightBackground": "#15201b",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#8fa699",
    "editorLineNumber.activeForeground": "#d6e3da",
    "editorIndentGuide.background1": "#00000000",
    "editorWhitespace.foreground": "#8fa69980",
    "editorGutter.background": "#15201b",
    "editorWidget.background": "#111a16",
    "editorWidget.foreground": "#d6e3da",
    "editorWidget.border": "#25362d",
    "editorSuggestWidget.background": "#111a16",
    "editorSuggestWidget.foreground": "#d6e3da",
    "editorSuggestWidget.selectedBackground": "#23402f",
    "editorSuggestWidget.selectedForeground": "#d6e3da",
    "editorHoverWidget.background": "#111a16",
    "editorHoverWidget.foreground": "#d6e3da",
    "editorHoverWidget.border": "#25362d",
    "editorHoverWidget.statusBarBackground": "#111a16",
    "widget.border": "#25362d",
    "editorSuggestWidget.border": "#25362d",
    "editorGroup.border": "#25362d",
    "editorGroupHeader.tabsBackground": "#111a16",
    "editorGroupHeader.noTabsBackground": "#111a16",
    "breadcrumb.background": "#111a16",
    "breadcrumb.foreground": "#8fa699",
    "tab.activeBackground": "#15201b",
    "tab.activeForeground": "#d6e3da",
    "tab.inactiveBackground": "#111a16",
    "tab.inactiveForeground": "#8fa699",
    "tab.border": "#111a16",
    "tab.activeBorder": "#6fdc9b",
    "titleBar.activeBackground": "#0d1511",
    "titleBar.activeForeground": "#d6e3da",
    "titleBar.inactiveBackground": "#0d1511",
    "titleBar.inactiveForeground": "#d6e3da",
    "titleBar.border": "#25362d",
    "menubar.selectionBackground": "#6fdc9b",
    "menubar.selectionForeground": "#000000",
    "menu.background": "#0d1511",
    "menu.foreground": "#d6e3da",
    "menu.selectionBackground": "#6fdc9b",
    "menu.selectionForeground": "#000000",
    "menu.border": "#25362d",
    "activityBar.background": "#0d1511",
    "activityBar.foreground": "#8fa699",
    "activityBar.inactiveForeground": "#8fa69999",
    "activityBarBadge.background": "#6fdc9b",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#111a16",
    "sideBar.foreground": "#d6e3da",
    "sideBar.border": "#25362d",
    "sideBarTitle.foreground": "#d6e3da",
    "sideBarSectionHeader.background": "#111a16",
    "sideBarSectionHeader.foreground": "#8fa699",
    "list.activeSelectionBackground": "#23402f",
    "list.activeSelectionForeground": "#d6e3da",
    "list.inactiveSelectionBackground": "#1A2D23",
    "list.inactiveSelectionForeground": "#d6e3da",
    "list.focusBackground": "#23402f",
    "list.focusForeground": "#d6e3da",
    "list.focusOutline": "#6fdc9b",
    "list.hoverBackground": "#1C3025",
    "list.highlightForeground": "#6fdc9b",
    "statusBar.background": "#6fdc9b",
    "statusBar.foreground": "#000000",
    "statusBar.noFolderBackground": "#6fdc9b",
    "statusBar.noFolderForeground": "#000000",
    "statusBar.debuggingBackground": "#AA0000",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.border": "#6fdc9b",
    "statusBarItem.hoverBackground": "#23402f",
    "statusBarItem.remoteBackground": "#6fdc9b",
    "statusBarItem.remoteForeground": "#000000",
    "panel.background": "#15201b",
    "panel.border": "#25362d",
    "panelTitle.activeForeground": "#d6e3da",
    "panelTitle.activeBorder": "#6fdc9b",
    "panelTitle.inactiveForeground": "#8fa699",
    "terminal.background": "#0f1713",
    "terminal.foreground": "#d6e3da",
    "terminalCursor.foreground": "#6fdc9b",
    "terminal.selectionBackground": "#23402f99",
    "input.background": "#111a16",
    "input.foreground": "#d6e3da",
    "input.border": "#25362d",
    "dropdown.background": "#111a16",
    "dropdown.foreground": "#d6e3da",
    "dropdown.border": "#25362d",
    "quickInput.background": "#111a16",
    "quickInput.foreground": "#d6e3da",
    "quickInputList.focusBackground": "#23402f",
    "quickInputList.focusForeground": "#d6e3da",
    "button.background": "#6fdc9b",
    "button.foreground": "#000000",
    "button.hoverBackground": "#23402f",
    "badge.background": "#6fdc9b",
    "badge.foreground": "#000000",
    "scrollbarSlider.background": "#23402f80",
    "scrollbarSlider.hoverBackground": "#23402fAA",
    "scrollbarSlider.activeBackground": "#23402f",
    "textPreformat.foreground": "#e6d48a",
    "textPreformat.background": "#FFFFFF1A",
    "textCodeBlock.background": "#00000040",
    "textBlockQuote.background": "#FFFFFF0F",
    "textLink.foreground": "#7dd3a8",
    "textLink.activeForeground": "#6fdc9b",
    "notifications.background": "#111a16",
    "notifications.foreground": "#d6e3da",
    "notifications.border": "#25362d",
    "peekView.border": "#25362d",
    "gitDecoration.modifiedResourceForeground": "#FFFF55",
    "gitDecoration.untrackedResourceForeground": "#55FF55",
    "gitDecoration.deletedResourceForeground": "#FF5555",
    "errorForeground": "#FF5555",
    "editorError.foreground": "#FF5555",
    "editorWarning.foreground": "#FFFF55",
    "editorInfo.foreground": "#55FFFF",
    "minimap.background": "#15201b",
    "terminal.ansiBlack": "#3B3F46",
    "terminal.ansiRed": "#FF6B6B",
    "terminal.ansiGreen": "#7BD88F",
    "terminal.ansiYellow": "#F3C677",
    "terminal.ansiBlue": "#6AA6FF",
    "terminal.ansiMagenta": "#C792EA",
    "terminal.ansiCyan": "#5FD0D6",
    "terminal.ansiWhite": "#D9DDE3",
    "terminal.ansiBrightBlack": "#6B7280",
    "terminal.ansiBrightRed": "#FF8F8F",
    "terminal.ansiBrightGreen": "#9BE7AC",
    "terminal.ansiBrightYellow": "#FFD88F",
    "terminal.ansiBrightBlue": "#8FBAFF",
    "terminal.ansiBrightMagenta": "#DCB0FF",
    "terminal.ansiBrightCyan": "#86E3E8",
    "terminal.ansiBrightWhite": "#FFFFFF"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8fa699",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7dd3a8",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#e6d48a"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#f0a97a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#9ad1ff"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#c7b6ff"
      }
    },
    {
      "scope": [
        "variable",
        "meta",
        "punctuation",
        "source"
      ],
      "settings": {
        "foreground": "#d6e3da"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#7dd3a8",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#9ad1ff"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#55FF55"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#FF5555"
      }
    }
  ]
}
