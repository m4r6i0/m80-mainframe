    "input.foreground": "#354346",
    "input.border": "#E0E5EB",
    "dropdown.background": "#E6EAEF",
    "dropdown.foreground": "#354346",
    "dropdown.border": "#E0E5EB",
    "quickInput.background": "#E6EAEF",
    "quickInput.foreground": "#354346",
    "quickInputList.focusBackground": "#E1E8ED",
    "quickInputList.focusForeground": "#354346",
    "button.background": "#278983",
    "button.foreground": "#000000",
    "button.hoverBackground": "#E1E8ED",
    "badge.background": "#278983",
    "badge.foreground": "#000000",
    "scrollbarSlider.background": "#E1E8ED80",
    "scrollbarSlider.hoverBackground": "#E1E8EDAA",
    "scrollbarSlider.activeBackground": "#E1E8ED",
    "textPreformat.foreground": "#277B9C",
    "textPreformat.background": "#0000001F",
    "textCodeBlock.background": "#0000001A",
    "textBlockQuote.background": "#0000000F",
    "textLink.foreground": "#277B9C",
    "textLink.activeForeground": "#278983",
    "notifications.background": "#E6EAEF",
    "notifications.foreground": "#354346",
    "notifications.border": "#E0E5EB",
    "peekView.border": "#E0E5EB",
    "gitDecoration.modifiedResourceForeground": "#5A2D00",
    "gitDecoration.untrackedResourceForeground": "#004D00",
    "gitDecoration.deletedResourceForeground": "#7A0000",
    "errorForeground": "#AA0000",
    "editorError.foreground": "#AA0000",
    "editorWarning.foreground": "#5A2D00",
    "editorInfo.foreground": "#0000AA",
    "minimap.background": "#E7EBF0",
    "terminal.ansiBlack": "#1F2433",
    "terminal.ansiRed": "#B3261E",
    "terminal.ansiGreen": "#1C7A45",
    "terminal.ansiYellow": "#8A5A00",
    "terminal.ansiBlue": "#1D5FD6",
    "terminal.ansiMagenta": "#8E3FB0",
    "terminal.ansiCyan": "#0B6F8A",
    "terminal.ansiWhite": "#596273",
    "terminal.ansiBrightBlack": "#3A4256",
    "terminal.ansiBrightRed": "#C93027",
    "terminal.ansiBrightGreen": "#20884F",
    "terminal.ansiBrightYellow": "#946000",
    "terminal.ansiBrightBlue": "#2A6DE3",
    "terminal.ansiBrightMagenta": "#9C4BBF",
    "terminal.ansiBrightCyan": "#0E7C99",
    "terminal.ansiBrightWhite": "#2D3342"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#697B81",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#277B9C",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#448C53"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#A56D1E"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#7B55B9"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#278983"
      }
    },
    {
      "scope": [
        "variable",
        "meta",
        "punctuation",
        "source"
      ],
      "settings": {
        "foreground": "#354346"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#277B9C",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7B55B9"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#00AA00"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#AA0000"
      }
    }
  ]
}
