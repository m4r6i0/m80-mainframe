    "menu.selectionForeground": "#000000",
    "menu.border": "#E0E5EB",
    "activityBar.background": "#E4E8ED",
    "activityBar.foreground": "#697B81",
    "activityBar.inactiveForeground": "#697B8199",
    "activityBarBadge.background": "#278983",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#E6EAEF",
    "sideBar.foreground": "#354346",
    "sideBar.border": "#E0E5EB",
    "sideBarTitle.foreground": "#354346",
    "sideBarSectionHeader.background": "#E6EAEF",
    "sideBarSectionHeader.foreground": "#697B81",
    "list.activeSelectionBackground": "#E1E8ED",
    "list.activeSelectionForeground": "#354346",
    "list.inactiveSelectionBackground": "#E3E9EE",
    "list.inactiveSelectionForeground": "#354346",
    "list.focusBackground": "#E1E8ED",
    "list.focusForeground": "#354346",
    "list.focusOutline": "#278983",
    "list.hoverBackground": "#E4E9EE",
    "list.highlightForeground": "#278983",
    "statusBar.background": "#278983",
    "statusBar.foreground": "#000000",
    "statusBar.noFolderBackground": "#278983",
    "statusBar.noFolderForeground": "#000000",
    "statusBar.debuggingBackground": "#AA0000",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.border": "#278983",
    "statusBarItem.hoverBackground": "#E1E8ED",
    "statusBarItem.remoteBackground": "#278983",
    "statusBarItem.remoteForeground": "#000000",
    "panel.background": "#E7EBF0",
    "panel.border": "#E0E5EB",
    "panelTitle.activeForeground": "#354346",
    "panelTitle.activeBorder": "#278983",
    "panelTitle.inactiveForeground": "#697B81",
    "terminal.background": "#E6EAEF",
    "terminal.foreground": "#354346",
    "terminalCursor.foreground": "#278983",
    "terminal.selectionBackground": "#E1E8ED99",
