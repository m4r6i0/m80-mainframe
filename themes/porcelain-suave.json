    "editorHoverWidget.background": "#E6EAEF",
    "editorHoverWidget.foreground": "#354346",
    "editorHoverWidget.border": "#E0E5EB",
    "editorHoverWidget.statusBarBackground": "#E6EAEF",
    "widget.border": "#E0E5EB",
    "editorSuggestWidget.border": "#E0E5EB",
    "editorGroup.border": "#E0E5EB",
    "editorGroupHeader.tabsBackground": "#E6EAEF",
    "editorGroupHeader.noTabsBackground": "#E6EAEF",
    "breadcrumb.background": "#E6EAEF",
    "breadcrumb.foreground": "#697B81",
    "tab.activeBackground": "#E7EBF0",
    "tab.activeForeground": "#354346",
    "tab.inactiveBackground": "#E6EAEF",
    "tab.inactiveForeground": "#697B81",
    "tab.border": "#E6EAEF",
    "tab.activeBorder": "#278983",
    "titleBar.activeBackground": "#E4E8ED",
