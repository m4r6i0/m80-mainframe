{
  "$schema": "vscode://schemas/color-theme",
  "name": "M80 Ocean Soft",
  "type": "dark",
  "semanticHighlighting": false,
  "colors": {
    "foreground": "#BCCFD7",
    "focusBorder": "#4BB3E6",
    "contrastBorder": "#1C313C",
    "widget.shadow": "#00000000",
    "selection.background": "#1A3547",
    "editor.background": "#13232D",
    "editor.foreground": "#BCCFD7",
    "editorCursor.foreground": "#4BB3E6",
    "editor.selectionBackground": "#1A3547",
    "editor.inactiveSelectionBackground": "#1A354780",
    "editor.selectionHighlightBackground": "#1A354755",
    "editor.wordHighlightBackground": "#1A354740",
    "editor.findMatchBackground": "#4BB3E6",
    "editor.findMatchHighlightBackground": "#1A354766",
    "editor.lineHighlightBackground": "#13232D",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#7897A5",
    "editorLineNumber.activeForeground": "#BCCFD7",
    "editorIndentGuide.background1": "#00000000",
    "editorWhitespace.foreground": "#7897A580",
    "editorGutter.background": "#13232D",
    "editorWidget.background": "#111F27",
    "editorWidget.foreground": "#BCCFD7",
    "editorWidget.border": "#1C313C",
    "editorSuggestWidget.background": "#111F27",
    "editorSuggestWidget.foreground": "#BCCFD7",
    "editorSuggestWidget.selectedBackground": "#1A3547",
    "editorSuggestWidget.selectedForeground": "#BCCFD7",
    "editorHoverWidget.background": "#111F27",
    "editorHoverWidget.foreground": "#BCCFD7",
    "editorHoverWidget.border": "#1C313C",
    "editorHoverWidget.statusBarBackground": "#111F27",
    "widget.border": "#1C313C",
    "editorSuggestWidget.border": "#1C313C",
    "editorGroup.border": "#1C313C",
    "editorGroupHeader.tabsBackground": "#111F27",
    "editorGroupHeader.noTabsBackground": "#111F27",
    "breadcrumb.background": "#111F27",
    "breadcrumb.foreground": "#7897A5",
    "tab.activeBackground": "#13232D",
    "tab.activeForeground": "#BCCFD7",
    "tab.inactiveBackground": "#111F27",
    "tab.inactiveForeground": "#7897A5",
    "tab.border": "#111F27",
    "tab.activeBorder": "#4BB3E6",
    "titleBar.activeBackground": "#0F1A21",
    "titleBar.activeForeground": "#BCCFD7",
    "titleBar.inactiveBackground": "#0F1A21",
    "titleBar.inactiveForeground": "#BCCFD7",
    "titleBar.border": "#1C313C",
    "menubar.selectionBackground": "#4BB3E6",
    "menubar.selectionForeground": "#000000",
    "menu.background": "#0F1A21",
    "menu.foreground": "#BCCFD7",
    "menu.selectionBackground": "#4BB3E6",
    "menu.selectionForeground": "#000000",
    "menu.border": "#1C313C",
    "activityBar.background": "#0F1A21",
    "activityBar.foreground": "#7897A5",
    "activityBar.inactiveForeground": "#7897A599",
    "activityBarBadge.background": "#4BB3E6",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#111F27",
    "sideBar.foreground": "#BCCFD7",
    "sideBar.border": "#1C313C",
    "sideBarTitle.foreground": "#BCCFD7",
    "sideBarSectionHeader.background": "#111F27",
    "sideBarSectionHeader.foreground": "#7897A5",
    "list.activeSelectionBackground": "#1A3547",
    "list.activeSelectionForeground": "#BCCFD7",
    "list.inactiveSelectionBackground": "#152A37",
    "list.inactiveSelectionForeground": "#BCCFD7",
    "list.focusBackground": "#1A3547",
    "list.focusForeground": "#BCCFD7",
    "list.focusOutline": "#4BB3E6",
    "list.hoverBackground": "#172C3A",
    "list.highlightForeground": "#4BB3E6",
    "statusBar.background": "#4BB3E6",
    "statusBar.foreground": "#000000",
    "statusBar.noFolderBackground": "#4BB3E6",
    "statusBar.noFolderForeground": "#000000",
    "statusBar.debuggingBackground": "#AA0000",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.border": "#4BB3E6",
    "statusBarItem.hoverBackground": "#1A3547",
    "statusBarItem.remoteBackground": "#4BB3E6",
    "statusBarItem.remoteForeground": "#000000",
    "panel.background": "#13232D",
    "panel.border": "#1C313C",
    "panelTitle.activeForeground": "#BCCFD7",
    "panelTitle.activeBorder": "#4BB3E6",
    "panelTitle.inactiveForeground": "#7897A5",
    "terminal.background": "#101D25",
    "terminal.foreground": "#BCCFD7",
    "terminalCursor.foreground": "#4BB3E6",
    "terminal.selectionBackground": "#1A354799",
    "input.background": "#111F27",
    "input.foreground": "#BCCFD7",
    "input.border": "#1C313C",
    "dropdown.background": "#111F27",
    "dropdown.foreground": "#BCCFD7",
    "dropdown.border": "#1C313C",
    "quickInput.background": "#111F27",
    "quickInput.foreground": "#BCCFD7",
    "quickInputList.focusBackground": "#1A3547",
    "quickInputList.focusForeground": "#BCCFD7",
    "button.background": "#4BB3E6",
    "button.foreground": "#000000",
    "button.hoverBackground": "#1A3547",
    "badge.background": "#4BB3E6",
    "badge.foreground": "#000000",
    "scrollbarSlider.background": "#1A354780",
    "scrollbarSlider.hoverBackground": "#1A3547AA",
    "scrollbarSlider.activeBackground": "#1A3547",
    "textPreformat.foreground": "#8ECCA7",
    "textPreformat.background": "#FFFFFF1A",
    "textCodeBlock.background": "#00000040",
    "textBlockQuote.background": "#FFFFFF0F",
    "textLink.foreground": "#64C1E6",
    "textLink.activeForeground": "#4BB3E6",
    "notifications.background": "#111F27",
    "notifications.foreground": "#BCCFD7",
    "notifications.border": "#1C313C",
    "peekView.border": "#1C313C",
    "gitDecoration.modifiedResourceForeground": "#FFFF55",
    "gitDecoration.untrackedResourceForeground": "#55FF55",
    "gitDecoration.deletedResourceForeground": "#FF5555",
    "errorForeground": "#FF5555",
    "editorError.foreground": "#FF5555",
    "editorWarning.foreground": "#FFFF55",
    "editorInfo.foreground": "#55FFFF",
    "minimap.background": "#13232D",
    "terminal.ansiBlack": "#3B3F46",
    "terminal.ansiRed": "#FF6B6B",
    "terminal.ansiGreen": "#7BD88F",
    "terminal.ansiYellow": "#F3C677",
    "terminal.ansiBlue": "#6AA6FF",
    "terminal.ansiMagenta": "#C792EA",
    "terminal.ansiCyan": "#5FD0D6",
    "terminal.ansiWhite": "#D9DDE3",
    "terminal.ansiBrightBlack": "#6B7280",
    "terminal.ansiBrightRed": "#FF8F8F",
    "terminal.ansiBrightGreen": "#9BE7AC",
    "terminal.ansiBrightYellow": "#FFD88F",
    "terminal.ansiBrightBlue": "#8FBAFF",
    "terminal.ansiBrightMagenta": "#DCB0FF",
    "terminal.ansiBrightCyan": "#86E3E8",
    "terminal.ansiBrightWhite": "#FFFFFF"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7897A5",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#64C1E6",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#8ECCA7"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#E3BA7B"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#96B3E6"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#E398BC"
      }
    },
    {
      "scope": [
        "variable",
        "meta",
        "punctuation",
        "source"
      ],
      "settings": {
        "foreground": "#BCCFD7"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#64C1E6",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#96B3E6"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#55FF55"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#FF5555"
      }
    }
  ]
}
