{
  "$schema": "vscode://schemas/color-theme",
  "name": "M80 Graphite",
  "type": "dark",
  "semanticHighlighting": false,
  "colors": {
    "foreground": "#dadde3",
    "focusBorder": "#6aa6ff",
    "contrastBorder": "#2d3036",
    "widget.shadow": "#00000000",
    "selection.background": "#2b3a52",
    "editor.background": "#1e2024",
    "editor.foreground": "#dadde3",
    "editorCursor.foreground": "#6aa6ff",
    "editor.selectionBackground": "#2b3a52",
    "editor.inactiveSelectionBackground": "#2b3a5280",
    "editor.selectionHighlightBackground": "#2b3a5255",
    "editor.wordHighlightBackground": "#2b3a5240",
    "editor.findMatchBackground": "#6aa6ff",
    "editor.findMatchHighlightBackground": "#2b3a5266",
    "editor.lineHighlightBackground": "#1e2024",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#9199a6",
    "editorLineNumber.activeForeground": "#dadde3",
    "editorIndentGuide.background1": "#00000000",
    "editorWhitespace.foreground": "#9199a680",
    "editorGutter.background": "#1e2024",
    "editorWidget.background": "#181a1d",
    "editorWidget.foreground": "#dadde3",
    "editorWidget.border": "#2d3036",
    "editorSuggestWidget.background": "#181a1d",
    "editorSuggestWidget.foreground": "#dadde3",
    "editorSuggestWidget.selectedBackground": "#2b3a52",
    "editorSuggestWidget.selectedForeground": "#dadde3",
    "editorHoverWidget.background": "#181a1d",
    "editorHoverWidget.foreground": "#dadde3",
    "editorHoverWidget.border": "#2d3036",
    "editorHoverWidget.statusBarBackground": "#181a1d",
    "widget.border": "#2d3036",
    "editorSuggestWidget.border": "#2d3036",
    "editorGroup.border": "#2d3036",
    "editorGroupHeader.tabsBackground": "#181a1d",
    "editorGroupHeader.noTabsBackground": "#181a1d",
    "breadcrumb.background": "#181a1d",
    "breadcrumb.foreground": "#9199a6",
    "tab.activeBackground": "#1e2024",
    "tab.activeForeground": "#dadde3",
    "tab.inactiveBackground": "#181a1d",
    "tab.inactiveForeground": "#9199a6",
    "tab.border": "#181a1d",
    "tab.activeBorder": "#6aa6ff",
    "titleBar.activeBackground": "#131416",
    "titleBar.activeForeground": "#dadde3",
    "titleBar.inactiveBackground": "#131416",
    "titleBar.inactiveForeground": "#dadde3",
    "titleBar.border": "#2d3036",
    "menubar.selectionBackground": "#6aa6ff",
    "menubar.selectionForeground": "#000000",
    "menu.background": "#131416",
    "menu.foreground": "#dadde3",
    "menu.selectionBackground": "#6aa6ff",
    "menu.selectionForeground": "#000000",
    "menu.border": "#2d3036",
    "activityBar.background": "#131416",
    "activityBar.foreground": "#9199a6",
    "activityBar.inactiveForeground": "#9199a699",
    "activityBarBadge.background": "#6aa6ff",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#181a1d",
    "sideBar.foreground": "#dadde3",
    "sideBar.border": "#2d3036",
    "sideBarTitle.foreground": "#dadde3",
    "sideBarSectionHeader.background": "#181a1d",
    "sideBarSectionHeader.foreground": "#9199a6",
    "list.activeSelectionBackground": "#2b3a52",
    "list.activeSelectionForeground": "#dadde3",
    "list.inactiveSelectionBackground": "#222A38",
    "list.inactiveSelectionForeground": "#dadde3",
    "list.focusBackground": "#2b3a52",
    "list.focusForeground": "#dadde3",
    "list.focusOutline": "#6aa6ff",
    "list.hoverBackground": "#252D3B",
    "list.highlightForeground": "#6aa6ff",
    "statusBar.background": "#6aa6ff",
    "statusBar.foreground": "#000000",
    "statusBar.noFolderBackground": "#6aa6ff",
    "statusBar.noFolderForeground": "#000000",
    "statusBar.debuggingBackground": "#AA0000",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.border": "#6aa6ff",
    "statusBarItem.hoverBackground": "#2b3a52",
    "statusBarItem.remoteBackground": "#6aa6ff",
    "statusBarItem.remoteForeground": "#000000",
    "panel.background": "#1e2024",
    "panel.border": "#2d3036",
    "panelTitle.activeForeground": "#dadde3",
    "panelTitle.activeBorder": "#6aa6ff",
    "panelTitle.inactiveForeground": "#9199a6",
    "terminal.background": "#16171a",
    "terminal.foreground": "#dadde3",
    "terminalCursor.foreground": "#6aa6ff",
    "terminal.selectionBackground": "#2b3a5299",
    "input.background": "#181a1d",
    "input.foreground": "#dadde3",
    "input.border": "#2d3036",
    "dropdown.background": "#181a1d",
    "dropdown.foreground": "#dadde3",
    "dropdown.border": "#2d3036",
    "quickInput.background": "#181a1d",
    "quickInput.foreground": "#dadde3",
    "quickInputList.focusBackground": "#2b3a52",
    "quickInputList.focusForeground": "#dadde3",
    "button.background": "#6aa6ff",
    "button.foreground": "#000000",
    "button.hoverBackground": "#2b3a52",
    "badge.background": "#6aa6ff",
    "badge.foreground": "#000000",
    "scrollbarSlider.background": "#2b3a5280",
    "scrollbarSlider.hoverBackground": "#2b3a52AA",
    "scrollbarSlider.activeBackground": "#2b3a52",
    "textPreformat.foreground": "#a5d6a7",
    "textPreformat.background": "#FFFFFF1A",
    "textCodeBlock.background": "#00000040",
    "textBlockQuote.background": "#FFFFFF0F",
    "textLink.foreground": "#7fb4ff",
    "textLink.activeForeground": "#6aa6ff",
    "notifications.background": "#181a1d",
    "notifications.foreground": "#dadde3",
    "notifications.border": "#2d3036",
    "peekView.border": "#2d3036",
    "gitDecoration.modifiedResourceForeground": "#FFFF55",
    "gitDecoration.untrackedResourceForeground": "#55FF55",
    "gitDecoration.deletedResourceForeground": "#FF5555",
    "errorForeground": "#FF5555",
    "editorError.foreground": "#FF5555",
    "editorWarning.foreground": "#FFFF55",
    "editorInfo.foreground": "#55FFFF",
    "minimap.background": "#1e2024",
    "terminal.ansiBlack": "#3B3F46",
    "terminal.ansiRed": "#FF6B6B",
    "terminal.ansiGreen": "#7BD88F",
    "terminal.ansiYellow": "#F3C677",
    "terminal.ansiBlue": "#6AA6FF",
    "terminal.ansiMagenta": "#C792EA",
    "terminal.ansiCyan": "#5FD0D6",
    "terminal.ansiWhite": "#D9DDE3",
    "terminal.ansiBrightBlack": "#6B7280",
    "terminal.ansiBrightRed": "#FF8F8F",
    "terminal.ansiBrightGreen": "#9BE7AC",
    "terminal.ansiBrightYellow": "#FFD88F",
    "terminal.ansiBrightBlue": "#8FBAFF",
    "terminal.ansiBrightMagenta": "#DCB0FF",
    "terminal.ansiBrightCyan": "#86E3E8",
    "terminal.ansiBrightWhite": "#FFFFFF"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9199a6",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7fb4ff",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a5d6a7"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#f3c677"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#c9a7ff"
      }
    },
    {
      "scope": [
        "variable",
        "meta",
        "punctuation",
        "source"
      ],
      "settings": {
        "foreground": "#dadde3"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#7fb4ff",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#55FF55"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#FF5555"
      }
    }
  ]
}
