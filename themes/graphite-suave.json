{
  "$schema": "vscode://schemas/color-theme",
  "name": "M80 Graphite Soft",
  "type": "dark",
  "semanticHighlighting": false,
  "colors": {
    "foreground": "#C3C6CC",
    "focusBorder": "#6196E5",
    "contrastBorder": "#272A31",
    "widget.shadow": "#00000000",
    "selection.background": "#263142",
    "editor.background": "#1E2026",
    "editor.foreground": "#C3C6CC",
    "editorCursor.foreground": "#6196E5",
    "editor.selectionBackground": "#263142",
    "editor.inactiveSelectionBackground": "#26314280",
    "editor.selectionHighlightBackground": "#26314255",
    "editor.wordHighlightBackground": "#26314240",
    "editor.findMatchBackground": "#6196E5",
    "editor.findMatchHighlightBackground": "#26314266",
    "editor.lineHighlightBackground": "#1E2026",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#838B97",
    "editorLineNumber.activeForeground": "#C3C6CC",
    "editorIndentGuide.background1": "#00000000",
    "editorWhitespace.foreground": "#838B9780",
    "editorGutter.background": "#1E2026",
    "editorWidget.background": "#1A1D21",
    "editorWidget.foreground": "#C3C6CC",
    "editorWidget.border": "#272A31",
    "editorSuggestWidget.background": "#1A1D21",
    "editorSuggestWidget.foreground": "#C3C6CC",
    "editorSuggestWidget.selectedBackground": "#263142",
    "editorSuggestWidget.selectedForeground": "#C3C6CC",
    "editorHoverWidget.background": "#1A1D21",
    "editorHoverWidget.foreground": "#C3C6CC",
    "editorHoverWidget.border": "#272A31",
    "editorHoverWidget.statusBarBackground": "#1A1D21",
    "widget.border": "#272A31",
    "editorSuggestWidget.border": "#272A31",
    "editorGroup.border": "#272A31",
    "editorGroupHeader.tabsBackground": "#1A1D21",
    "editorGroupHeader.noTabsBackground": "#1A1D21",
    "breadcrumb.background": "#1A1D21",
    "breadcrumb.foreground": "#838B97",
    "tab.activeBackground": "#1E2026",
    "tab.activeForeground": "#C3C6CC",
    "tab.inactiveBackground": "#1A1D21",
    "tab.inactiveForeground": "#838B97",
    "tab.border": "#1A1D21",
    "tab.activeBorder": "#6196E5",
    "titleBar.activeBackground": "#17191D",
    "titleBar.activeForeground": "#C3C6CC",
    "titleBar.inactiveBackground": "#17191D",
    "titleBar.inactiveForeground": "#C3C6CC",
    "titleBar.border": "#272A31",
    "menubar.selectionBackground": "#6196E5",
    "menubar.selectionForeground": "#000000",
    "menu.background": "#17191D",
    "menu.foreground": "#C3C6CC",
    "menu.selectionBackground": "#6196E5",
    "menu.selectionForeground": "#000000",
    "menu.border": "#272A31",
    "activityBar.background": "#17191D",
    "activityBar.foreground": "#838B97",
    "activityBar.inactiveForeground": "#838B9799",
    "activityBarBadge.background": "#6196E5",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#1A1D21",
    "sideBar.foreground": "#C3C6CC",
    "sideBar.border": "#272A31",
    "sideBarTitle.foreground": "#C3C6CC",
    "sideBarSectionHeader.background": "#1A1D21",
    "sideBarSectionHeader.foreground": "#838B97",
    "list.activeSelectionBackground": "#263142",
    "list.activeSelectionForeground": "#C3C6CC",
    "list.inactiveSelectionBackground": "#202732",
    "list.inactiveSelectionForeground": "#C3C6CC",
    "list.focusBackground": "#263142",
    "list.focusForeground": "#C3C6CC",
    "list.focusOutline": "#6196E5",
    "list.hoverBackground": "#222834",
    "list.highlightForeground": "#6196E5",
    "statusBar.background": "#6196E5",
    "statusBar.foreground": "#000000",
    "statusBar.noFolderBackground": "#6196E5",
    "statusBar.noFolderForeground": "#000000",
    "statusBar.debuggingBackground": "#AA0000",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.border": "#6196E5",
    "statusBarItem.hoverBackground": "#263142",
    "statusBarItem.remoteBackground": "#6196E5",
    "statusBarItem.remoteForeground": "#000000",
    "panel.background": "#1E2026",
    "panel.border": "#272A31",
    "panelTitle.activeForeground": "#C3C6CC",
    "panelTitle.activeBorder": "#6196E5",
    "panelTitle.inactiveForeground": "#838B97",
    "terminal.background": "#191B1F",
    "terminal.foreground": "#C3C6CC",
    "terminalCursor.foreground": "#6196E5",
    "terminal.selectionBackground": "#26314299",
    "input.background": "#1A1D21",
    "input.foreground": "#C3C6CC",
    "input.border": "#272A31",
    "dropdown.background": "#1A1D21",
    "dropdown.foreground": "#C3C6CC",
    "dropdown.border": "#272A31",
    "quickInput.background": "#1A1D21",
    "quickInput.foreground": "#C3C6CC",
    "quickInputList.focusBackground": "#263142",
    "quickInputList.focusForeground": "#C3C6CC",
    "button.background": "#6196E5",
    "button.foreground": "#000000",
    "button.hoverBackground": "#263142",
    "badge.background": "#6196E5",
    "badge.foreground": "#000000",
    "scrollbarSlider.background": "#26314280",
    "scrollbarSlider.hoverBackground": "#263142AA",
    "scrollbarSlider.activeBackground": "#263142",
    "textPreformat.foreground": "#95C098",
    "textPreformat.background": "#FFFFFF1A",
    "textCodeBlock.background": "#00000040",
    "textBlockQuote.background": "#FFFFFF0F",
    "textLink.foreground": "#73A2E5",
    "textLink.activeForeground": "#6196E5",
    "notifications.background": "#1A1D21",
    "notifications.foreground": "#C3C6CC",
    "notifications.border": "#272A31",
    "peekView.border": "#272A31",
    "gitDecoration.modifiedResourceForeground": "#FFFF55",
    "gitDecoration.untrackedResourceForeground": "#55FF55",
    "gitDecoration.deletedResourceForeground": "#FF5555",
    "errorForeground": "#FF5555",
    "editorError.foreground": "#FF5555",
    "editorWarning.foreground": "#FFFF55",
    "editorInfo.foreground": "#55FFFF",
    "minimap.background": "#1E2026",
    "terminal.ansiBlack": "#3B3F46",
    "terminal.ansiRed": "#FF6B6B",
    "terminal.ansiGreen": "#7BD88F",
    "terminal.ansiYellow": "#F3C677",
    "terminal.ansiBlue": "#6AA6FF",
    "terminal.ansiMagenta": "#C792EA",
    "terminal.ansiCyan": "#5FD0D6",
    "terminal.ansiWhite": "#D9DDE3",
    "terminal.ansiBrightBlack": "#6B7280",
    "terminal.ansiBrightRed": "#FF8F8F",
    "terminal.ansiBrightGreen": "#9BE7AC",
    "terminal.ansiBrightYellow": "#FFD88F",
    "terminal.ansiBrightBlue": "#8FBAFF",
    "terminal.ansiBrightMagenta": "#DCB0FF",
    "terminal.ansiBrightCyan": "#86E3E8",
    "terminal.ansiBrightWhite": "#FFFFFF"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#838B97",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#73A2E5",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#95C098"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#D9B26D"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#CDAD71"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#B497E5"
      }
    },
    {
      "scope": [
        "variable",
        "meta",
        "punctuation",
        "source"
      ],
      "settings": {
        "foreground": "#C3C6CC"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#73A2E5",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#CDAD71"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#55FF55"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#FF5555"
      }
    }
  ]
}
