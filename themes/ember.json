{
  "$schema": "vscode://schemas/color-theme",
  "name": "M80 Ember",
  "type": "dark",
  "semanticHighlighting": false,
  "colors": {
    "foreground": "#e6dfd9",
    "focusBorder": "#ff8c4a",
    "contrastBorder": "#352f2b",
    "widget.shadow": "#00000000",
    "selection.background": "#4a3326",
    "editor.background": "#201c1a",
    "editor.foreground": "#e6dfd9",
    "editorCursor.foreground": "#ff8c4a",
    "editor.selectionBackground": "#4a3326",
    "editor.inactiveSelectionBackground": "#4a332680",
    "editor.selectionHighlightBackground": "#4a332655",
    "editor.wordHighlightBackground": "#4a332640",
    "editor.findMatchBackground": "#ff8c4a",
    "editor.findMatchHighlightBackground": "#4a332666",
    "editor.lineHighlightBackground": "#201c1a",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#a89c93",
    "editorLineNumber.activeForeground": "#e6dfd9",
    "editorIndentGuide.background1": "#00000000",
    "editorWhitespace.foreground": "#a89c9380",
    "editorGutter.background": "#201c1a",
    "editorWidget.background": "#1a1716",
    "editorWidget.foreground": "#e6dfd9",
    "editorWidget.border": "#352f2b",
    "editorSuggestWidget.background": "#1a1716",
    "editorSuggestWidget.foreground": "#e6dfd9",
    "editorSuggestWidget.selectedBackground": "#4a3326",
    "editorSuggestWidget.selectedForeground": "#e6dfd9",
    "editorHoverWidget.background": "#1a1716",
    "editorHoverWidget.foreground": "#e6dfd9",
    "editorHoverWidget.border": "#352f2b",
    "editorHoverWidget.statusBarBackground": "#1a1716",
    "widget.border": "#352f2b",
    "editorSuggestWidget.border": "#352f2b",
    "editorGroup.border": "#352f2b",
    "editorGroupHeader.tabsBackground": "#1a1716",
    "editorGroupHeader.noTabsBackground": "#1a1716",
    "breadcrumb.background": "#1a1716",
    "breadcrumb.foreground": "#a89c93",
    "tab.activeBackground": "#201c1a",
    "tab.activeForeground": "#e6dfd9",
    "tab.inactiveBackground": "#1a1716",
    "tab.inactiveForeground": "#a89c93",
    "tab.border": "#1a1716",
    "tab.activeBorder": "#ff8c4a",
    "titleBar.activeBackground": "#141211",
    "titleBar.activeForeground": "#e6dfd9",
    "titleBar.inactiveBackground": "#141211",
    "titleBar.inactiveForeground": "#e6dfd9",
    "titleBar.border": "#352f2b",
    "menubar.selectionBackground": "#ff8c4a",
    "menubar.selectionForeground": "#000000",
    "menu.background": "#141211",
    "menu.foreground": "#e6dfd9",
    "menu.selectionBackground": "#ff8c4a",
    "menu.selectionForeground": "#000000",
    "menu.border": "#352f2b",
    "activityBar.background": "#141211",
    "activityBar.foreground": "#a89c93",
    "activityBar.inactiveForeground": "#a89c9399",
    "activityBarBadge.background": "#ff8c4a",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#1a1716",
    "sideBar.foreground": "#e6dfd9",
    "sideBar.border": "#352f2b",
    "sideBarTitle.foreground": "#e6dfd9",
    "sideBarSectionHeader.background": "#1a1716",
    "sideBarSectionHeader.foreground": "#a89c93",
    "list.activeSelectionBackground": "#4a3326",
    "list.activeSelectionForeground": "#e6dfd9",
    "list.inactiveSelectionBackground": "#32251E",
    "list.inactiveSelectionForeground": "#e6dfd9",
    "list.focusBackground": "#4a3326",
    "list.focusForeground": "#e6dfd9",
    "list.focusOutline": "#ff8c4a",
    "list.hoverBackground": "#352820",
    "list.highlightForeground": "#ff8c4a",
    "statusBar.background": "#ff8c4a",
    "statusBar.foreground": "#000000",
    "statusBar.noFolderBackground": "#ff8c4a",
    "statusBar.noFolderForeground": "#000000",
    "statusBar.debuggingBackground": "#AA0000",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.border": "#ff8c4a",
    "statusBarItem.hoverBackground": "#4a3326",
    "statusBarItem.remoteBackground": "#ff8c4a",
    "statusBarItem.remoteForeground": "#000000",
    "panel.background": "#201c1a",
    "panel.border": "#352f2b",
    "panelTitle.activeForeground": "#e6dfd9",
    "panelTitle.activeBorder": "#ff8c4a",
    "panelTitle.inactiveForeground": "#a89c93",
    "terminal.background": "#161312",
    "terminal.foreground": "#e6dfd9",
    "terminalCursor.foreground": "#ff8c4a",
    "terminal.selectionBackground": "#4a332699",
    "input.background": "#1a1716",
    "input.foreground": "#e6dfd9",
    "input.border": "#352f2b",
    "dropdown.background": "#1a1716",
    "dropdown.foreground": "#e6dfd9",
    "dropdown.border": "#352f2b",
    "quickInput.background": "#1a1716",
    "quickInput.foreground": "#e6dfd9",
    "quickInputList.focusBackground": "#4a3326",
    "quickInputList.focusForeground": "#e6dfd9",
    "button.background": "#ff8c4a",
    "button.foreground": "#000000",
    "button.hoverBackground": "#4a3326",
    "badge.background": "#ff8c4a",
    "badge.foreground": "#000000",
    "scrollbarSlider.background": "#4a332680",
    "scrollbarSlider.hoverBackground": "#4a3326AA",
    "scrollbarSlider.activeBackground": "#4a3326",
    "textPreformat.foreground": "#b7da8a",
    "textPreformat.background": "#FFFFFF1A",
    "textCodeBlock.background": "#00000040",
    "textBlockQuote.background": "#FFFFFF0F",
    "textLink.foreground": "#ffa268",
    "textLink.activeForeground": "#ff8c4a",
    "notifications.background": "#1a1716",
    "notifications.foreground": "#e6dfd9",
    "notifications.border": "#352f2b",
    "peekView.border": "#352f2b",
    "gitDecoration.modifiedResourceForeground": "#FFFF55",
    "gitDecoration.untrackedResourceForeground": "#55FF55",
    "gitDecoration.deletedResourceForeground": "#FF5555",
    "errorForeground": "#FF5555",
    "editorError.foreground": "#FF5555",
    "editorWarning.foreground": "#FFFF55",
    "editorInfo.foreground": "#55FFFF",
    "minimap.background": "#201c1a",
    "terminal.ansiBlack": "#3B3F46",
    "terminal.ansiRed": "#FF6B6B",
    "terminal.ansiGreen": "#7BD88F",
    "terminal.ansiYellow": "#F3C677",
    "terminal.ansiBlue": "#6AA6FF",
    "terminal.ansiMagenta": "#C792EA",
    "terminal.ansiCyan": "#5FD0D6",
    "terminal.ansiWhite": "#D9DDE3",
    "terminal.ansiBrightBlack": "#6B7280",
    "terminal.ansiBrightRed": "#FF8F8F",
    "terminal.ansiBrightGreen": "#9BE7AC",
    "terminal.ansiBrightYellow": "#FFD88F",
    "terminal.ansiBrightBlue": "#8FBAFF",
    "terminal.ansiBrightMagenta": "#DCB0FF",
    "terminal.ansiBrightCyan": "#86E3E8",
    "terminal.ansiBrightWhite": "#FFFFFF"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a89c93",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ffa268",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#b7da8a"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#f6d067"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#8bc7e8"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#e0a8ff"
      }
    },
    {
      "scope": [
        "variable",
        "meta",
        "punctuation",
        "source"
      ],
      "settings": {
        "foreground": "#e6dfd9"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#ffa268",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8bc7e8"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#55FF55"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#FF5555"
      }
    }
  ]
}
